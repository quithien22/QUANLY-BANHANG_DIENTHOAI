# Copy file nay thanh ".env" (cung thu muc voi server.js) roi dien thong tin that.

# Ket noi SQL Server (BAT BUOC: DB_PASSWORD, DB_SERVER; server se khong khoi dong neu thieu)
DB_USER=sa
DB_PASSWORD=
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=QuanLyBanHangDienThoai
DB_INSTANCE=

# Khoa ky JWT (BAT BUOC, it nhat 32 ky tu ngau nhien).
# Tao: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Han token nhan vien (admin), mac dinh 12h neu bo trong. Dinh dang: 15m | 12h | 7d | so giay
JWT_ADMIN_EXPIRES_IN=12h

# Dia chi public cua backend, dung de dung URL anh upload (mac dinh http://localhost:8080)
PUBLIC_API_URL=http://localhost:8080

# Lay thong tin sandbox tai: https://developers.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Dia chi MoMo goi ve sau khi thanh toan xong (can URL public, vi du ngrok: https://xxxx.ngrok-free.app/api/payment/momo-ipn)
MOMO_IPN_URL=http://localhost:8080/api/payment/momo-ipn
MOMO_REDIRECT_URL=http://localhost:3000/thanh-toan-thanh-cong

# Chatbot AI (Gemini). Lay khoa tai Google AI Studio. KHONG dua khoa nay vao frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Dang nhap Google: dung CUNG Client ID voi REACT_APP_GOOGLE_CLIENT_ID o frontend (dang xxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=891745779425-nrpduohofosnbl4paltfb6fjdkeljhcm.apps.googleusercontent.com
